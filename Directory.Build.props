<Project>

  <!--
    ============================================================================
    Platform package pins — Net.Agora.Video.Android / .iOS, published from their own repos
    ============================================================================
    This repository binds nothing itself: the raw Android/iOS bindings live in
    sbokatuk/Net.Agora.Android and sbokatuk/Net.Agora.iOS, each an independently versioned,
    independently released package, and Net.Agora.Video depends on them via ordinary
    PackageReference at an exact pinned version — never a floating range, since a float would turn
    an unrelated upstream change into a build break here. Each version is
    <native SDK version>.<binding revision> in its own repository — see sbokatuk/Net.Agora.Android
    and sbokatuk/Net.Agora.iOS's own Directory.Build.props. The numbers needn't match, and often
    don't: Agora ships Android, iOS and macOS on independent schedules, and either side can be the
    one ahead. The iOS pod for a release has lagged Maven Central by a point version before; with
    4.7.0 it is the other way round, on CocoaPods for iOS and macOS but not yet on Maven.
  -->
  <PropertyGroup>
    <NetAgoraVideoAndroidVersion>4.6.4.1</NetAgoraVideoAndroidVersion>
    <NetAgoraVideoIosVersion>4.7.0.1</NetAgoraVideoIosVersion>
    <NetAgoraVoiceAndroidVersion>4.6.4.1</NetAgoraVoiceAndroidVersion>
    <NetAgoraVoiceIosVersion>4.7.0.1</NetAgoraVoiceIosVersion>
    <!--
      Signaling and the RTC products each ship an `aosl`, and all of them land at one path in a
      consuming app — lib/<abi>/libaosl.so on Android, Frameworks/aosl.framework on Apple — so the
      app keeps a single copy and both products run against it. Each Signaling pin is therefore
      chosen against the RTC pins above, not on its own. Before 2.2.6.3 the copies did not get along:
      on Android RtcEngine.Create() returned null on a device, with a build that reported nothing.
      iOS 2.2.6.4 carries the aosl 1.3.16 that the RTC 4.7.0 pods bundle, which RTC 4.7.0 needs and
      RTC 4.6.2 also loads against. See each binding repository's signaling-v release notes.
    -->
    <NetAgoraSignalingAndroidVersion>2.2.6.3</NetAgoraSignalingAndroidVersion>
    <NetAgoraSignalingIosVersion>2.2.6.4</NetAgoraSignalingIosVersion>
    <!--
      The native macOS (AppKit) bindings, from sbokatuk/Net.Agora.Mac. Only Video, Voice and
      Signaling have a macOS leg — Agora ships no native macOS SDK for Chat/Whiteboard/Fastboard.
      These are a distinct platform from the iOS ones (net*-macos / AppKit, not Mac Catalyst, which
      Agora ships no slice for), on version lines of their own that need not match the iOS ones.
    -->
    <NetAgoraVideoMacVersion>4.7.0.1</NetAgoraVideoMacVersion>
    <NetAgoraVoiceMacVersion>4.7.0.1</NetAgoraVoiceMacVersion>
    <!--
      Net.Agora.Signaling.Mac takes its aosl out of the macOS RTC archive, so each Signaling.Mac
      release pairs with one Video.Mac/Voice.Mac line. Move the pins as the pair its release note names.
    -->
    <NetAgoraSignalingMacVersion>2.3.0.2</NetAgoraSignalingMacVersion>
    <NetAgoraChatAndroidVersion>1.4.0.2</NetAgoraChatAndroidVersion>
    <!--
      Ahead of Android's, which is not a mistake: Net.Agora.Chat.iOS 1.4.0.3 and 1.4.0.4 each moved
      its AgoraInfra_iOS pin, which has no Android counterpart. The Chat pod itself is 1.4.0 on both.
    -->
    <NetAgoraChatIosVersion>1.4.0.4</NetAgoraChatIosVersion>
    <!--
      The one product whose two platform packages sit on different version lines. netless keeps the
      Android and iOS whiteboard SDKs in separate repositories with separate release cadences, so
      unlike the RTC pair there is no reason to expect them to meet.
    -->
    <NetAgoraWhiteboardAndroidVersion>2.16.134.1</NetAgoraWhiteboardAndroidVersion>
    <NetAgoraWhiteboardIosVersion>2.16.147.1</NetAgoraWhiteboardIosVersion>
    <!--
      Fastboard is a release track of its own. On Android it depends on Net.Agora.Whiteboard.Android
      at a minimum version; on iOS it embeds its own copy of the whiteboard. Either way its pins need
      not follow the whiteboard ones.
    -->
    <NetAgoraFastboardAndroidVersion>1.8.1.2</NetAgoraFastboardAndroidVersion>
    <NetAgoraFastboardIosVersion>1.4.5.2</NetAgoraFastboardIosVersion>

    <!--
      Each product's own version is its iOS platform package's native version, plus a revision
      counter of this repository's — the convention sbokatuk/DatadogNet's facade uses too. That is a
      fixed rule, chosen so the number never depends on which platform happens to be ahead: it
      doesn't claim the other platforms run that native version. Android's RTC line is behind iOS's
      today (4.6.4 against 4.7.0) where it used to be ahead; each release note's package table
      gives the native version on every platform. The global VersionPrefix default is the Video
      line; the Voice projects override it with theirs.
    -->
    <AgoraVideoIosVersion>4.7.0</AgoraVideoIosVersion>
    <AgoraVoiceIosVersion>4.7.0</AgoraVoiceIosVersion>
    <AgoraBindingRevision>1</AgoraBindingRevision>
    <!--
      Signaling is a different product with its own native version line (2.2.x) and its own
      revision counter — it did not exist when the RTC products shipped revision 1.
    -->
    <AgoraSignalingIosVersion>2.2.6</AgoraSignalingIosVersion>
    <AgoraSignalingBindingRevision>4</AgoraSignalingBindingRevision>
    <!--
      Chat is a third product on a third native line — 1.4.x — with its own revision counter, for
      the same reason Signaling has one.
    -->
    <AgoraChatIosVersion>1.4.0</AgoraChatIosVersion>
    <AgoraChatBindingRevision>4</AgoraChatBindingRevision>
    <!--
      Whiteboard tracks its iOS line, like every other product here — which for this one means the
      newer of the two.
    -->
    <AgoraWhiteboardIosVersion>2.16.147</AgoraWhiteboardIosVersion>
    <AgoraWhiteboardBindingRevision>1</AgoraWhiteboardBindingRevision>
    <!--
      Fastboard, likewise: its own native line and its own revision counter.
    -->
    <AgoraFastboardIosVersion>1.4.5</AgoraFastboardIosVersion>
    <AgoraFastboardBindingRevision>2</AgoraFastboardBindingRevision>
    <VersionPrefix>$(AgoraVideoIosVersion).$(AgoraBindingRevision)</VersionPrefix>
  </PropertyGroup>

  <!--
    ============================================================================
    Target frameworks
    ============================================================================
    Used by this repository's own multi-targeted packages (Net.Agora.Video, Net.Agora.Video.Maui —
    matching whichever target frameworks the platform packages ship). No single SDK can build net8,
    net9 and net10 for a given platform: each SDK's workload carries only the current band and the
    previous one.

                  SDK 9 band                          SDK 10 band
      Android     net8.0-android34.0, net9.0-*35.0    net10.0-android36.0
      iOS         net8.0-ios18.0,     net9.0-ios18.0  net10.0-ios26.0

    So each is packed twice and the results are merged — see build/BuildNugets.sh and
    build/merge-packages.py. AgoraSdkBand selects which pass a given build is.
  -->
  <PropertyGroup>
    <AgoraSdkBand Condition=" '$(AgoraSdkBand)' == '' ">net9</AgoraSdkBand>

    <AgoraAndroidTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net9' ">net8.0-android34.0;net9.0-android35.0</AgoraAndroidTargetFrameworks>
    <AgoraAndroidTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net10' ">net10.0-android36.0</AgoraAndroidTargetFrameworks>

    <AgoraIosTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net9' ">net8.0-ios18.0;net9.0-ios18.0</AgoraIosTargetFrameworks>
    <AgoraIosTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net10' ">net10.0-ios26.0</AgoraIosTargetFrameworks>

    <!--
      The native macOS (AppKit) leg. Only the products with a Net.Agora.<P>.Mac binding carry it —
      Video, Voice and Signaling — so it is a separate band property those csprojs append to their
      TargetFrameworks, rather than part of the shared Apple list. macOS has no simulator and one
      universal slice, so the two-pass net9/net10 merge is the same shape as iOS. There is no MAUI
      companion for it: MAUI's only desktop-Mac target is Mac Catalyst, which Agora ships no slice
      for — see the .Maui csprojs.
    -->
    <AgoraMacosTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net9' ">net8.0-macos15.0;net9.0-macos15.0</AgoraMacosTargetFrameworks>
    <AgoraMacosTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net10' ">net10.0-macos26.0</AgoraMacosTargetFrameworks>

    <!--
      The neutral leg, for the base facade packages only (not .Maui — the views need a platform).
      It exists so a plain class library — shared ViewModels, a net9.0-windows or Mac Catalyst
      head, a test project — can *reference* the package, program against IAgora*Client, and get
      a PlatformNotSupportedException at construction instead of today's NU1202 restore failure
      with no explanation. Compiles Platforms/Neutral, which binds nothing.
    -->
    <AgoraNeutralTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net9' ">net8.0;net9.0</AgoraNeutralTargetFrameworks>
    <AgoraNeutralTargetFrameworks Condition=" '$(AgoraSdkBand)' == 'net10' ">net10.0</AgoraNeutralTargetFrameworks>
  </PropertyGroup>

  <!--
    Net.Agora.UnitTests is run with -p:AgoraNeutralOnly=true so the façades it references collapse
    to their neutral target frameworks. It has to be a global property rather than reference
    metadata: restore walks every target framework of a referenced project regardless of what the
    reference asks for, so neither SetTargetFramework nor AdditionalProperties prunes it. Without
    it, referencing them drags the android/ios/macos legs into the reference graph, and merely
    *evaluating* those needs the
    matching workloads installed — which would turn the unit-test job from the pipeline's fastest
    signal (plain ubuntu, no workloads, no packed packages) into a mobile-SDK install.

    Only ever set by that test project. A pack must never set it: it would silently produce
    packages with no platform legs at all.
  -->
  <PropertyGroup Condition=" '$(AgoraNeutralOnly)' == 'true' ">
    <AgoraAndroidTargetFrameworks></AgoraAndroidTargetFrameworks>
    <AgoraIosTargetFrameworks></AgoraIosTargetFrameworks>
    <AgoraMacosTargetFrameworks></AgoraMacosTargetFrameworks>
  </PropertyGroup>

  <!--
    ============================================================================
    Shared package metadata
    ============================================================================
  -->
  <PropertyGroup>
    <Authors>s.bokatuk</Authors>
    <Company>s.bokatuk</Company>
    <Copyright>Copyright © s.bokatuk</Copyright>
    <PackageProjectUrl>https://github.com/sbokatuk/Net.Agora</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbokatuk/Net.Agora</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>

    <!--
      net8.0-* and net9.0-* are past end of support, which the SDK reports as an error. They ship
      deliberately: .NET 8 is still where a large share of MAUI apps are.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>

</Project>
