<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI conveniences over Net.Agora.Voice: the platform glue a MAUI app would otherwise write by
    hand — today that is the Android Activity lookup behind CreateClient(). No view, no handler:
    voice renders nothing, which is why this package is so much smaller than Net.Agora.Video.Maui.

    Separate from Net.Agora.Voice on purpose. Everything here needs Microsoft.Maui.Essentials,
    and forcing that on a plain .NET for Android or .NET for iOS consumer to get an Agora client
    would be a poor trade.

    No Mac Catalyst leg — see Net.Agora.Voice.csproj.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks)</TargetFrameworks>

    <AssemblyName>Net.Agora.Voice.Maui</AssemblyName>
    <RootNamespace>Net.Agora.Voice.Maui</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <VersionPrefix>$(AgoraVoiceIosVersion).$(AgoraBindingRevision)</VersionPrefix>

    <!--
      UseMauiCore rather than UseMaui: this is a library of extensions, not an app, and the full
      UseMaui brings in app-only targets (resource generation, splash screens) that have nothing
      to do here.
    -->
    <UseMauiCore>true</UseMauiCore>
    <UseMauiEssentials>true</UseMauiEssentials>
    <SingleProject>true</SingleProject>

    <!--
      MA002: since .NET 8, UseMauiCore/UseMauiEssentials no longer implicitly add the matching
      PackageReference — they still set up everything actually needed to build and pack this
      project, and the suggested explicit PackageReference is version-pinned to a single band,
      which fights the net8/net9/net10 multi-targeting here. Silencing the advisory rather than
      the underlying behavior.
    -->
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>

  <PropertyGroup>
    <AgoraVoiceDependencyVersion Condition=" '$(AgoraVoiceDependencyVersion)' == '' ">$(Version)</AgoraVoiceDependencyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Net.Agora.Voice" Version="[$(AgoraVoiceDependencyVersion)]" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Net.Agora.Voice.Maui</PackageId>
    <Title>.NET MAUI helpers for Net.Agora.Voice.</Title>
    <Description>The platform glue a .NET MAUI app needs to use Net.Agora.Voice without writing platform code: CreateClient() supplies the Android Activity that RtcEngineConfig requires. Add Net.Agora.Voice on its own if you are not using MAUI.</Description>
    <PackageTags>Agora;RTC;voice;audio;streaming;SDK;MAUI;Android;iOS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
