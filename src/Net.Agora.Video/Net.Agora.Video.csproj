<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cross-platform API: joins an Agora RTC channel and publishes/subscribes audio and video
    with one surface over Android's RtcEngine and iOS's AgoraRtcEngineKit.

    Deliberately no MAUI dependency, so plain .NET for Android and .NET for iOS apps can use this.
    The MAUI view lives in Net.Agora.Video.Maui.

    No Mac Catalyst leg: Agora ships no maccatalyst slice for AgoraRtcKit.xcframework (ios-arm64 and
    simulator only) — see sbokatuk/Net.Agora.iOS's README.

    Both platforms' target frameworks are listed together, which is why this can only be packed on
    macOS — restoring the iOS leg needs the iOS workload. See build/BuildNugets.sh.

    Net.Agora.Video.Android and Net.Agora.Video.iOS are NOT part of this repository — this package
    depends on them the same way any consumer would, at an exact pinned version
    (NetAgoraVideoAndroidVersion / NetAgoraVideoIosVersion in Directory.Build.props), restored from
    nuget.org (or, for local development, from the ./artifacts folder source in NuGet.config once
    those two repositories' own build/BuildNugets.sh has packed them there). See docs/BUILD.md.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraNeutralTargetFrameworks);$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks);$(AgoraMacosTargetFrameworks)</TargetFrameworks>

    <AssemblyName>Net.Agora.Video</AssemblyName>
    <RootNamespace>Net.Agora.Video</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Platform code is picked per target framework rather than by the default glob, which would try
    to compile the Android half into the iOS assembly.
  -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
  </ItemGroup>

  <!--
    The neutral leg (plain net8.0/net9.0/net10.0): no binding, no platform reference — a client
    whose constructor throws PlatformNotSupportedException. See AgoraNeutralTargetFrameworks in
    Directory.Build.props for why it ships.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
    <Compile Include="Platforms/Neutral/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
    <PackageReference Include="Net.Agora.Video.Android" Version="[$(NetAgoraVideoAndroidVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Include="Platforms/Apple/**/*.cs" />
    <PackageReference Include="Net.Agora.Video.iOS" Version="[$(NetAgoraVideoIosVersion)]" />
  </ItemGroup>

  <!--
    The native macOS (AppKit) leg shares the Platforms/Apple sources with iOS: the same
    AgoraRtcEngineKit surface, with the file's own #if MACOS handling the two differences (an NSView
    canvas instead of UIView, and the iOS-only speakerphone/switch-camera calls the macOS engine
    does not implement). Binds the Net.Agora.Video.Mac package — see sbokatuk/Net.Agora.Mac.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <Compile Include="Platforms/Apple/**/*.cs" />
    <PackageReference Include="Net.Agora.Video.Mac" Version="[$(NetAgoraVideoMacVersion)]" />
  </ItemGroup>

  <!--
    The unit tests assert AgoraVirtualBackground's internal source-type plumbing — the values the
    platform halves hand the engine, which no public member exposes — and AgoraEngineSlot, whose
    whole behaviour is internal. They could see both for free while the test project
    compile-linked this project's sources; now that it references the project and tests the real
    neutral assembly, the internals need granting instead.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Net.Agora.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Net.Agora.Video</PackageId>
    <Title>Cross-platform .NET client for the Agora Video (RTC) SDK.</Title>
    <Description>One API over the Agora Video SDK for Android and iOS: join a channel and publish/subscribe audio and video with awaitable calls and ordinary .NET events, instead of writing a per-platform adapter over a Java event-handler class and an Objective-C delegate. Pulls in the platform binding that matches whichever target framework you build. For .NET MAUI apps, add Net.Agora.Video.Maui for the video view.</Description>
    <PackageTags>Agora;RTC;video;streaming;SDK;MAUI;Android;iOS;Binding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
