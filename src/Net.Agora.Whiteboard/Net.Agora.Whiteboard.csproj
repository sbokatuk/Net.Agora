<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cross-platform API: joins an Agora Interactive Whiteboard room and draws on it, with one
    surface over Android's WhiteSdk and iOS's WhiteSDK.

    Deliberately no MAUI dependency here, and a MAUI companion package that carries more than the
    others': the board needs a *view*, so Net.Agora.Whiteboard.Maui has an AgoraWhiteboardView and
    its handlers, like Net.Agora.Video.Maui rather than the glue-only Voice and Chat ones.

    No Mac Catalyst leg: the Whiteboard binding is built for iOS device and simulator only — see
    sbokatuk/Net.Agora.iOS's build/build-whiteboard.sh.

    Both platforms' target frameworks are listed together, which is why this can only be packed on
    macOS — restoring the iOS leg needs the iOS workload. See build/BuildNugets.sh.

    Net.Agora.Whiteboard.Android and Net.Agora.Whiteboard.iOS are NOT part of this repository — this package
    depends on them the same way any consumer would, at an exact pinned version
    (NetAgoraWhiteboardAndroidVersion / NetAgoraWhiteboardIosVersion in Directory.Build.props), restored from
    nuget.org (or, for local development, from the ./artifacts folder source in NuGet.config once
    those two repositories' own build/BuildNugets.sh has packed them there). See docs/BUILD.md.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraNeutralTargetFrameworks);$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks)</TargetFrameworks>

    <AssemblyName>Net.Agora.Whiteboard</AssemblyName>
    <RootNamespace>Net.Agora.Whiteboard</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <VersionPrefix>$(AgoraWhiteboardIosVersion).$(AgoraWhiteboardBindingRevision)</VersionPrefix>
  </PropertyGroup>

  <!--
    Platform code is picked per target framework rather than by the default glob, which would try
    to compile the Android half into the iOS assembly.
  -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
  </ItemGroup>

  <!--
    The neutral leg (plain net8.0/net9.0/net10.0): no binding, no platform reference — a client
    whose constructor throws PlatformNotSupportedException. See AgoraNeutralTargetFrameworks in
    Directory.Build.props for why it ships.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
    <Compile Include="Platforms/Neutral/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
    <PackageReference Include="Net.Agora.Whiteboard.Android" Version="[$(NetAgoraWhiteboardAndroidVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Include="Platforms/Apple/**/*.cs" />
    <PackageReference Include="Net.Agora.Whiteboard.iOS" Version="[$(NetAgoraWhiteboardIosVersion)]" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Net.Agora.Whiteboard</PackageId>
    <Title>Cross-platform .NET client for the Agora Interactive Whiteboard SDK.</Title>
    <Description>One API over the Agora Interactive Whiteboard SDK for Android and iOS: join a room, pick a tool and colour, draw, undo, redo and clear, with awaitable calls and ordinary .NET events instead of a per-platform adapter over a Java Promise and an Objective-C completion block. Pulls in the platform binding that matches whichever target framework you build. Add Net.Agora.Whiteboard.Maui in a .NET MAUI app to get the board as a MAUI view.</Description>
    <PackageTags>Agora;Whiteboard;drawing;collaboration;SDK;MAUI;Android;iOS;Binding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
