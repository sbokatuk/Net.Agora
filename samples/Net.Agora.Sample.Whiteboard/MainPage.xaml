<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:agora="clr-namespace:Net.Agora.Whiteboard.Maui;assembly=Net.Agora.Whiteboard.Maui"
             x:Class="Net.Agora.Sample.Whiteboard.MainPage"
             Title="Net.Agora Whiteboard">

    <Grid Padding="12" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="2*,*" ColumnSpacing="8">
            <Entry x:Name="AppIdentifierEntry" Placeholder="Whiteboard App Identifier (org/app)" />
            <Entry x:Name="RegionEntry" Grid.Column="1" Keyboard="Plain" Placeholder="Region, e.g. us-sv" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Entry x:Name="RoomUuidEntry" Placeholder="Room UUID" />
            <Entry x:Name="RoomTokenEntry" Grid.Column="1" Placeholder="Room token" />
        </Grid>

        <!-- The board itself. Its handler is registered by UseAgoraWhiteboard() in MauiProgram. -->
        <agora:AgoraWhiteboardView x:Name="Board" Grid.Row="2" />

        <!-- Wraps because seven buttons are wider than a phone: in one row, Redo and Clear are off-screen. -->
        <FlexLayout Grid.Row="3" Wrap="Wrap">
            <Button x:Name="JoinButton" Text="Join" Margin="0,0,8,8" Clicked="OnJoinClicked" />
            <Button x:Name="LeaveButton" Text="Leave" Margin="0,0,8,8" Clicked="OnLeaveClicked" IsEnabled="False" />
            <Button x:Name="PencilButton" Text="Pencil" Margin="0,0,8,8" Clicked="OnPencilClicked" IsEnabled="False" />
            <Button x:Name="EraserButton" Text="Eraser" Margin="0,0,8,8" Clicked="OnEraserClicked" IsEnabled="False" />
            <Button x:Name="UndoButton" Text="Undo" Margin="0,0,8,8" Clicked="OnUndoClicked" IsEnabled="False" />
            <Button x:Name="RedoButton" Text="Redo" Margin="0,0,8,8" Clicked="OnRedoClicked" IsEnabled="False" />
            <Button x:Name="ClearButton" Text="Clear" Margin="0,0,8,8" Clicked="OnClearClicked" IsEnabled="False" />
        </FlexLayout>

        <!--
            No LineBreakMode: a truncating label isn't re-measured when its text changes, so this
            one, which starts empty, would keep a height of zero and never appear.
        -->
        <Label x:Name="StatusLabel" Grid.Row="4" FontFamily="OpenSansRegular" FontSize="12" />

    </Grid>

</ContentPage>
