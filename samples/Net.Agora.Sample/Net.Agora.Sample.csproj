<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI sample that joins an Agora RTC channel and publishes/subscribes audio and video.
    Consumes the packed Net.Agora.Video.Maui package from artifacts/ (see NuGet.config), so it
    exercises the packages exactly as a consumer would.

    Target frameworks follow the SDK band, like the binding projects: no single .NET SDK can build
    net8, net9 and net10 for a platform. Build the other band with -p:AgoraSdkBand=net10 from a
    directory whose global.json selects the .NET 10 SDK.

    No Mac Catalyst leg — see src/Net.Agora.Video/Net.Agora.Video.csproj.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Net.Agora.Sample</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>Net.Agora Sample</ApplicationTitle>
    <ApplicationId>com.sbokatuk.agora.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Defaults to the version in Directory.Build.props so a plain build after
      "build/BuildNugets.sh video" works; override with -p:AgoraVideoPackageVersion=... to test a
      specific build.
    -->
    <AgoraVideoPackageVersion Condition=" '$(AgoraVideoPackageVersion)' == '' ">$(VersionPrefix)</AgoraVideoPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!--
      Supplies ILoggingBuilder.AddDebug, which MauiProgram calls inside #if DEBUG. Referenced
      unconditionally rather than only for Debug: a configuration-dependent PackageReference makes
      restore differ between configurations, and this is how the MAUI template ships it.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <!--
      Net.Agora.Video.Maui brings Net.Agora.Video with it, which in turn brings the platform
      binding that matches whichever target framework is being built. One reference covers all of
      it. Exact version, in brackets — a bare version is a *minimum* to NuGet, so a build missing
      from artifacts/ would silently resolve from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="Net.Agora.Video.Maui" Version="[$(AgoraVideoPackageVersion)]" />

    <!--
      The extensions the page's three feature switches drive. Platform packages, not facades —
      there is no cross-platform package for them — so each platform gets its own reference at the
      platform binding's pinned version. Leave them out and the switches still compile; they just
      answer a failure code at runtime, which is what the sample then shows.
    -->
    <PackageReference Include="Net.Agora.Extensions.VirtualBackground.Android" Version="[$(NetAgoraVideoAndroidVersion)]" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="Net.Agora.Extensions.ClearVision.Android" Version="[$(NetAgoraVideoAndroidVersion)]" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="Net.Agora.Extensions.Ains.Android" Version="[$(NetAgoraVideoAndroidVersion)]" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />

    <PackageReference Include="Net.Agora.Extensions.VirtualBackground.iOS" Version="[$(NetAgoraVideoIosVersion)]" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <PackageReference Include="Net.Agora.Extensions.ClearVision.iOS" Version="[$(NetAgoraVideoIosVersion)]" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <PackageReference Include="Net.Agora.Extensions.Ains.iOS" Version="[$(NetAgoraVideoIosVersion)]" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
  </ItemGroup>

</Project>
