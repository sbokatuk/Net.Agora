<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Net.Agora.Sample.Signaling.MainPage"
             Title="Net.Agora Signaling">

    <Grid Padding="16" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <Entry x:Name="AppIdEntry" Grid.Row="0" Placeholder="App ID (from the Agora Console)" />
        <Entry x:Name="UserIdEntry" Grid.Row="1" Placeholder="Your user id" Text="maui-user" />
        <Entry x:Name="ChannelEntry" Grid.Row="2" Placeholder="Channel" Text="net-agora-signaling-sample" />
        <Entry x:Name="TokenEntry" Grid.Row="3" Placeholder="Token (empty for App ID-only projects)" />

        <HorizontalStackLayout Grid.Row="4" Spacing="8">
            <Button x:Name="LoginButton" Text="Log in" Clicked="OnLoginClicked" />
            <Button x:Name="LogoutButton" Text="Log out" Clicked="OnLogoutClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <ScrollView x:Name="MessagesScroll" Grid.Row="5">
            <Label x:Name="MessagesLabel" FontFamily="OpenSansRegular" FontSize="12" />
        </ScrollView>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="MessageEntry" Placeholder="Say something" IsEnabled="False" />
            <Button x:Name="SendButton" Grid.Column="1" Text="Send" Clicked="OnSendClicked" IsEnabled="False" />
        </Grid>

    </Grid>

</ContentPage>
