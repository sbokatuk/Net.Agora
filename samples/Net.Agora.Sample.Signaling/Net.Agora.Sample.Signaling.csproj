<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI sample that logs in to Agora Signaling, subscribes to a channel and publishes/receives
    messages — a tiny chat room. Consumes the packed Net.Agora.Signaling package from artifacts/
    (see NuGet.config). It references Net.Agora.Signaling.Maui — not because Signaling needs the
    glue (it does not), but so this sample's CreateClient() reads the same as every other product's.

    Target frameworks follow the SDK band, like the binding projects. No Mac Catalyst leg — see
    src/Net.Agora.Signaling/Net.Agora.Signaling.csproj.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Net.Agora.Sample.Signaling</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>Net.Agora Signaling Sample</ApplicationTitle>
    <ApplicationId>com.sbokatuk.agora.sample.signaling</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Defaults to the version in Directory.Build.props so a plain build after
      "build/BuildNugets.sh signaling" works; override with -p:AgoraSignalingPackageVersion=...
      to test a specific build.
    -->
    <AgoraSignalingPackageVersion Condition=" '$(AgoraSignalingPackageVersion)' == '' ">$(AgoraSignalingIosVersion).$(AgoraSignalingBindingRevision)</AgoraSignalingPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!--
      Supplies ILoggingBuilder.AddDebug, which MauiProgram calls inside #if DEBUG. Referenced
      unconditionally rather than only for Debug: a configuration-dependent PackageReference makes
      restore differ between configurations, and this is how the MAUI template ships it.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <!--
      Net.Agora.Signaling brings the platform binding that matches whichever target framework is
      being built. Exact version, in brackets — a bare version is a *minimum* to NuGet, so a build
      missing from artifacts/ would silently resolve from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="Net.Agora.Signaling.Maui" Version="[$(AgoraSignalingPackageVersion)]" />
  </ItemGroup>

</Project>
