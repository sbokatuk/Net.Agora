<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI sample that joins an Interactive Fastboard room and draws on it. Consumes the packed
    Net.Agora.Fastboard and Net.Agora.Fastboard.Maui packages from artifacts/ (see NuGet.config),
    so it exercises them exactly as a consumer would — and the .Maui companion earns more of its
    keep here than in the other products, since it supplies the board view itself rather than just
    hiding an #if ANDROID.

    Target frameworks follow the SDK band, like the binding projects. No Mac Catalyst leg — see
    src/Net.Agora.Chat/Net.Agora.Chat.csproj.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks)</TargetFrameworks>
    <!--
      Android-only on Linux. `dotnet build -f <android tfm>` still restores every target framework
      in the list, and the iOS workload does not exist on Linux at all (NETSDK1178), so a Linux
      restore with the iOS heads present can never succeed - this is what lets CI's per-product
      sample build/link check run its Android leg on a Linux runner. Scoped to the samples: the
      packages themselves are only ever packed on macOS (see build/BuildNugets.sh), where the full
      list always applies.
    -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(AgoraAndroidTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Net.Agora.Sample.Fastboard</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>Net.Agora Fastboard Sample</ApplicationTitle>
    <ApplicationId>com.sbokatuk.agora.sample.fastboard</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Defaults to the version in Directory.Build.props so a plain build after
      "build/BuildNugets.sh fastboard" works; override with -p:AgoraFastboardPackageVersion=... to test a
      specific build.
    -->
    <AgoraFastboardPackageVersion Condition=" '$(AgoraFastboardPackageVersion)' == '' ">$(AgoraFastboardIosVersion).$(AgoraFastboardBindingRevision)</AgoraFastboardPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!--
      Supplies ILoggingBuilder.AddDebug, which MauiProgram calls inside #if DEBUG. Referenced
      unconditionally rather than only for Debug: a configuration-dependent PackageReference makes
      restore differ between configurations, and this is how the MAUI template ships it.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <!--
      Net.Agora.Fastboard.Maui pulls in Net.Agora.Fastboard, which in turn brings the platform binding that
      matches whichever target framework is being built. Exact version, in brackets — a bare
      version is a *minimum* to NuGet, so a build missing from artifacts/ would silently resolve
      from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="Net.Agora.Fastboard.Maui" Version="[$(AgoraFastboardPackageVersion)]" />
  </ItemGroup>

  <!--
    Android on .NET 8 only. Without these the build fails in D8, on whichever duplicate it reaches
    first:

        Type androidx.collection.ArraySetKt is defined multiple times

    AndroidX moved its Kotlin extensions out of the -ktx artifacts and into the base ones, which
    left the -ktx packages empty. This graph holds both halves of that move:

        Whiteboard.Android -> WebKit 1.14.0.1 -> Core 1.16.0.3
            -> Collection 1.5.0.3, Lifecycle.Runtime 2.9.2.1
        Fastboard.Android -> AppCompat 1.7.0.7
            -> Activity 1.10.1.2, Lifecycle.ViewModel 2.8.7.4
            -> Fragment 1.8.6.2 -> Lifecycle.LiveData.Core 2.8.7.4      (extensions moved in)
        Maui.Core 8.0.100 -> Navigation.Common/Fragment/Runtime 2.6.0.1
            -> Activity.Ktx 1.7.2.1, Collection.Ktx 1.2.0.9,
               the 2.6.1.3 Lifecycle -ktx packages                      (extensions still here)

    NuGet raises the base packages and nothing raises their -ktx partners, so the same classes
    arrive twice. Pin each -ktx to the version of its base package, where it is empty. The Lifecycle
    pins differ because this graph already mixes the 2.8 and 2.9 lines. Lifecycle.ViewModel.Ktx
    collides too, but Activity.Ktx 1.10.1.2 raises it to an empty 2.8.7.4 without a pin. A direct
    reference outranks every transitive vote, as with the Fastboard pin in
    tests/Net.Agora.DeviceTests. MAUI 9 asks for the empty -ktx packages on its own, so net9 needs
    no pin.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And $(TargetFramework.StartsWith('net8'))">
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.10.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.8.7.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.9.2.1" />
  </ItemGroup>

</Project>
