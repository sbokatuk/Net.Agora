<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Net.Agora.Sample.Voice.MainPage"
             Title="Net.Agora Voice">

    <Grid Padding="16" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <Entry x:Name="AppIdEntry" Grid.Row="0" Placeholder="App ID (from the Agora Console)" />
        <Entry x:Name="ChannelIdEntry" Grid.Row="1" Placeholder="Channel id" Text="net-agora-voice-sample" />
        <Entry x:Name="TokenEntry" Grid.Row="2" Placeholder="Token (empty for App ID-only projects)" />

        <HorizontalStackLayout Grid.Row="3" Spacing="8">
            <Button x:Name="JoinButton" Text="Join" Clicked="OnJoinClicked" />
            <Button x:Name="LeaveButton" Text="Leave" Clicked="OnLeaveClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Spacing="24">
            <HorizontalStackLayout Spacing="4">
                <Label Text="Mute" VerticalOptions="Center" />
                <Switch x:Name="MuteSwitch" Toggled="OnMuteToggled" IsEnabled="False" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4">
                <Label Text="Speaker" VerticalOptions="Center" />
                <Switch x:Name="SpeakerSwitch" Toggled="OnSpeakerToggled" />
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <Label x:Name="SpeakersLabel" Grid.Row="5" Text="nobody is speaking" FontAttributes="Italic" />

        <ScrollView x:Name="StatusScroll" Grid.Row="6">
            <Label x:Name="StatusLabel" FontFamily="OpenSansRegular" FontSize="12" />
        </ScrollView>

    </Grid>

</ContentPage>
