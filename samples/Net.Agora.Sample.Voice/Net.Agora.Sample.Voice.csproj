<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI sample that joins an Agora RTC channel and publishes/subscribes audio — the voice-only
    sibling of samples/Net.Agora.Sample, with no video views and no camera permission. Consumes
    the packed Net.Agora.Voice.Maui package from artifacts/ (see NuGet.config), so it exercises
    the packages exactly as a consumer would.

    Target frameworks follow the SDK band, like the binding projects: no single .NET SDK can build
    net8, net9 and net10 for a platform. Build the other band with -p:AgoraSdkBand=net10 from a
    directory whose global.json selects the .NET 10 SDK.

    No Mac Catalyst leg — see src/Net.Agora.Voice/Net.Agora.Voice.csproj.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AgoraAndroidTargetFrameworks);$(AgoraIosTargetFrameworks)</TargetFrameworks>
    <!--
      Android-only on Linux. `dotnet build -f <android tfm>` still restores every target framework
      in the list, and the iOS workload does not exist on Linux at all (NETSDK1178), so a Linux
      restore with the iOS heads present can never succeed - this is what lets CI's per-product
      sample build/link check run its Android leg on a Linux runner. Scoped to the samples: the
      packages themselves are only ever packed on macOS (see build/BuildNugets.sh), where the full
      list always applies.
    -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(AgoraAndroidTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Net.Agora.Sample.Voice</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>Net.Agora Voice Sample</ApplicationTitle>
    <ApplicationId>com.sbokatuk.agora.sample.voice</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Defaults to the version in Directory.Build.props so a plain build after
      "build/BuildNugets.sh voice" works; override with -p:AgoraVoicePackageVersion=... to test a
      specific build.
    -->
    <AgoraVoicePackageVersion Condition=" '$(AgoraVoicePackageVersion)' == '' ">$(AgoraVoiceIosVersion).$(AgoraBindingRevision)</AgoraVoicePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!--
      Supplies ILoggingBuilder.AddDebug, which MauiProgram calls inside #if DEBUG. Referenced
      unconditionally rather than only for Debug: a configuration-dependent PackageReference makes
      restore differ between configurations, and this is how the MAUI template ships it.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />

    <!--
      Net.Agora.Voice.Maui brings Net.Agora.Voice with it, which in turn brings the platform
      binding that matches whichever target framework is being built. One reference covers all of
      it. Exact version, in brackets — a bare version is a *minimum* to NuGet, so a build missing
      from artifacts/ would silently resolve from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="Net.Agora.Voice.Maui" Version="[$(AgoraVoicePackageVersion)]" />
  </ItemGroup>

</Project>
