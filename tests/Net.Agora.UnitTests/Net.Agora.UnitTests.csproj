<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Covers the platform-independent logic in the façades: the options and event-arg types, the
    client interfaces' contracts, and the neutral constructors, for every product. Plain net9.0,
    no device.

    The façades are referenced as ordinary projects: each carries a plain net8.0/net9.0/net10.0
    neutral leg alongside its platform target frameworks (AgoraNeutralTargetFrameworks in
    Directory.Build.props), so this net9.0 test project resolves the real neutral assemblies — the
    same ones a consumer's shared class library gets — rather than re-compiling linked sources
    into itself, which is what this project did before the neutral leg existed. The concrete
    clients' join/timeout/cancellation/dispose state machine still needs a real engine to
    construct and is covered on-device instead — see Net.Agora.DeviceTests; what the neutral leg
    itself promises, PlatformNotSupportedException at construction, is asserted here in
    NeutralPlatformTests.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Referencing the façades pulls their whole target-framework set into the restore graph, and
    merely evaluating the android/ios/macos legs needs the matching workloads installed. Restore
    walks every leg of a referenced project regardless of what the reference asks for — neither
    SetTargetFramework nor AdditionalProperties prunes it — so the lever is the global property
    -p:AgoraNeutralOnly=true, which collapses the façades to their neutral legs (see
    Directory.Build.props). CI passes it; locally either form works, plain `dotnet test` just
    restores more.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Net.Agora.Video/Net.Agora.Video.csproj" />
    <ProjectReference Include="../../src/Net.Agora.Voice/Net.Agora.Voice.csproj" />
    <ProjectReference Include="../../src/Net.Agora.Signaling/Net.Agora.Signaling.csproj" />
    <ProjectReference Include="../../src/Net.Agora.Chat/Net.Agora.Chat.csproj" />
    <ProjectReference Include="../../src/Net.Agora.Whiteboard/Net.Agora.Whiteboard.csproj" />
    <ProjectReference Include="../../src/Net.Agora.Fastboard/Net.Agora.Fastboard.csproj" />
  </ItemGroup>

</Project>
