<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which façade to exercise (Video, Voice, Signaling, Chat, Whiteboard or Fastboard) and which of its target frameworks. Both go
      through properties of our own: overriding TargetFramework directly on the command line
      breaks restore, and the two façades cannot be referenced together — their platform packages
      carry the same native artifacts, so one app holds one of them.

      One project with two heads, not four projects: the point of this suite is that the same
      checks compile and pass on both platforms (and both products), and projects sharing a linked
      file would make it possible for one of them to drift.
    -->
    <AgoraDeviceProduct Condition=" '$(AgoraDeviceProduct)' == '' ">Video</AgoraDeviceProduct>
    <DefineConstants Condition=" '$(AgoraDeviceProduct)' == 'Signaling' ">$(DefineConstants);AGORA_SIGNALING</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDeviceProduct)' == 'Chat' ">$(DefineConstants);AGORA_CHAT</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDeviceProduct)' == 'Whiteboard' ">$(DefineConstants);AGORA_WHITEBOARD</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDeviceProduct)' == 'Fastboard' ">$(DefineConstants);AGORA_FASTBOARD</DefineConstants>
    <AgoraDeviceTargetFramework Condition=" '$(AgoraDeviceTargetFramework)' == '' ">net9.0-ios18.0</AgoraDeviceTargetFramework>
    <TargetFramework>$(AgoraDeviceTargetFramework)</TargetFramework>
    <DefineConstants Condition=" '$(AgoraDeviceProduct)' == 'Voice' ">$(DefineConstants);AGORA_VOICE</DefineConstants>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.agora.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <!--
      The checks report through stdout, which the runner streams back with `simctl launch` in
      console-pty mode. Quietening the Mono logger keeps that stream to the test output rather than
      runtime chatter.
    -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>

    <!--
      The interpreter, explicitly. The .NET 9 iOS SDK JITs a Debug simulator build; the .NET 8 one
      puts the runtime in aot-only mode for the same command line and dies on the first assembly it
      has no AOT image for. Set for both bands rather than only net8 so the two runs are comparable
      — a check that passes under the interpreter on one platform version and under the JIT on
      another is not testing quite the same thing.
    -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Matches the sample app's floor — see samples/Net.Agora.Sample/Net.Agora.Sample.csproj. -->
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>

    <!--
      The property, not an @(AndroidManifest) item. The .NET 9 Android SDK is happy with the item
      form; the .NET 8 one reads $(AndroidManifest), defaults it to the project root, and fails with
      XA1018 ("Specified AndroidManifest file does not exist").
    -->
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <!-- The floor .NET for macOS enforces — see sbokatuk/Net.Agora.Mac's src/Agora.Binding.props. -->
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <!-- Same reasoning as the iOS head: keep the captured stdout to the checks, not runtime chatter. -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
    <None Include="Platforms/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="Platforms/Android/**/*.cs" />
    <None Remove="Platforms/Android/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Include="Platforms/iOS/**/*.cs" />
    <None Remove="Platforms/iOS/**/*.cs" />
    <!--
      Both None (the item type) and LogicalName="Info.plist" (the metadata) are required. This is a
      plain iOS SDK project, not MAUI — samples/Net.Agora.Sample gets Platforms/iOS/Info.plist
      recognised for free because Microsoft.Maui.Sdk has its own convention for it; the raw iOS SDK
      instead auto-generates a manifest from ApplicationId/ApplicationVersion and does not look
      under Platforms/ for one at all — a plain, unreferenced file there built clean but none of its
      keys (camera/microphone usage descriptions, orientations) made it into the app bundle's actual
      Info.plist. _DetectAppManifest (Xamarin.Shared.targets) locates a manifest by LogicalName
      rather than by path, and only searches @(None) first — a BundleResource item is found too, but
      only on a second pass, and only after triggering "Info.plist files should have a Build Action
      of 'None'" on every build.
    -->
    <None Include="Platforms/iOS/Info.plist" LogicalName="Info.plist" />
  </ItemGroup>

  <!--
    The macOS (AppKit) head. Same LogicalName requirement as iOS — see the comment above; the raw
    macOS SDK locates a manifest the same way the iOS one does.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <Compile Include="Platforms/Mac/**/*.cs" />
    <None Remove="Platforms/Mac/**/*.cs" />
    <None Include="Platforms/Mac/Info.plist" LogicalName="Info.plist" />
  </ItemGroup>

  <!--
    Only Video, Voice and Signaling have a macOS leg: Agora ships no native macOS SDK for Chat, and
    netless none for Whiteboard/Fastboard, so those façades are android+ios only. Asking for one of
    them on a macos target framework would fail restore with a message about the package not
    supporting it, which says nothing useful — fail here instead, naming the reason.
  -->
  <Target Name="AgoraRejectUnsupportedMacosProduct"
          BeforeTargets="Build;Restore"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'
                     And '$(AgoraDeviceProduct)' != 'Video'
                     And '$(AgoraDeviceProduct)' != 'Voice'
                     And '$(AgoraDeviceProduct)' != 'Signaling'">
    <Error Text="AgoraDeviceProduct '$(AgoraDeviceProduct)' has no macOS leg — only Video, Voice and Signaling do. Agora ships no native macOS SDK for Chat, and netless none for the boards." />
  </Target>

  <!--
    The device tests deliberately consume the packed NuGet from ./artifacts rather than a
    ProjectReference, so they exercise the artifact that actually gets published — including its
    dependency on Net.Agora.Video.Android / .iOS, which a ProjectReference would prove nothing
    about. See NuGet.config for the local feed.

    The .Maui packages are deliberately absent. This app is not a MAUI app: keeping the checks free
    of the MAUI workload is what lets them prove that the *façade* works rather than that MAUI's
    plumbing does, and it keeps the emulator/simulator run from spending minutes on a MAUI build.
    The sample app is what exercises the .Maui packages.
  -->
  <PropertyGroup>
    <AgoraPackageVersion Condition=" '$(AgoraPackageVersion)' == '' And '$(AgoraDeviceProduct)' == 'Voice' ">$(AgoraVoiceIosVersion).$(AgoraBindingRevision)</AgoraPackageVersion>
    <AgoraPackageVersion Condition=" '$(AgoraPackageVersion)' == '' And '$(AgoraDeviceProduct)' == 'Signaling' ">$(AgoraSignalingIosVersion).$(AgoraSignalingBindingRevision)</AgoraPackageVersion>
    <AgoraPackageVersion Condition=" '$(AgoraPackageVersion)' == '' And '$(AgoraDeviceProduct)' == 'Chat' ">$(AgoraChatIosVersion).$(AgoraChatBindingRevision)</AgoraPackageVersion>
    <AgoraPackageVersion Condition=" '$(AgoraPackageVersion)' == '' And '$(AgoraDeviceProduct)' == 'Whiteboard' ">$(AgoraWhiteboardIosVersion).$(AgoraWhiteboardBindingRevision)</AgoraPackageVersion>
    <AgoraPackageVersion Condition=" '$(AgoraPackageVersion)' == '' And '$(AgoraDeviceProduct)' == 'Fastboard' ">$(AgoraFastboardIosVersion).$(AgoraFastboardBindingRevision)</AgoraPackageVersion>
    <AgoraPackageVersion Condition=" '$(AgoraPackageVersion)' == '' ">$(VersionPrefix)</AgoraPackageVersion>

    <!--
      The extensions ride the RTC line and are published from the binding repositories, so they
      carry the *platform* pins rather than this repository's facade version.
    -->
    <AgoraExtensionAndroidVersion Condition=" '$(AgoraExtensionAndroidVersion)' == '' ">$(NetAgoraVideoAndroidVersion)</AgoraExtensionAndroidVersion>
    <AgoraExtensionIosVersion Condition=" '$(AgoraExtensionIosVersion)' == '' ">$(NetAgoraVideoIosVersion)</AgoraExtensionIosVersion>
    <AgoraExtensionMacVersion Condition=" '$(AgoraExtensionMacVersion)' == '' ">$(NetAgoraVideoMacVersion)</AgoraExtensionMacVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Net.Agora.$(AgoraDeviceProduct)" Version="$(AgoraPackageVersion)" />
  </ItemGroup>

  <!--
    Fastboard on Android only. Fastboard's transitive graph asks for two mutually-exclusive
    Xamarin.AndroidX.Lifecycle.Common ranges and NuGet cannot unify them, so restore fails outright
    with NU1107 before anything builds:

        Fastboard.Android -> Whiteboard.Android -> WebKit -> Core 1.16.0.3
            -> Lifecycle.Runtime 2.9.2.1 -> Lifecycle.Common [>= 2.9.2.1 && < 2.9.3]
        Fastboard.Android -> AppCompat -> Fragment -> LiveData.Core 2.8.7.4
            -> Lifecycle.Common [>= 2.8.7.4 && < 2.8.8]

    Pin the newer one directly, which is exactly what NU1107 asks for ("Install/reference
    Xamarin.AndroidX.Lifecycle.Common 2.9.2.1 directly to resolve this issue"). A direct reference
    outranks every transitive vote, so the graph resolves to one version. Scoped to Fastboard: the
    Whiteboard façade on its own does not pull the AppCompat side of the diamond, so its own leg
    restores clean and must not be perturbed. net10's newer AndroidX graph reconciles without help,
    but the pin is harmless there — 2.9.2.1 satisfies its constraints too.
  -->
  <ItemGroup Condition=" '$(AgoraDeviceProduct)' == 'Fastboard' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.9.2.1" />
  </ItemGroup>

  <!--
    The extension packages the RTC heads exercise. They are platform packages, not facades — there
    is no cross-platform package to reference — so each platform gets its own list, at the platform
    binding's pinned version rather than the facade's.

    They are here because they are the only way to prove the extension switches work: the call
    compiles and links whether or not the native payload is present, and answers a failure code
    when it is not. See the ExtensionsAreAvailable check in SmokeTests.cs.

    Audio-only for the Voice head — the voice engine has no video pipeline for the rest to act on.
  -->
  <PropertyGroup>
    <!--
      Set false to build the same app *without* the extension payloads. That is how the
      ExtensionsAreAvailable check was shown to be worth having: with the packages it passes, and
      without them the engine refuses the switches, which is the whole point. Left as a knob rather
      than a one-off experiment so the claim stays checkable.
    -->
    <AgoraReferenceExtensions Condition=" '$(AgoraReferenceExtensions)' == '' ">true</AgoraReferenceExtensions>
  </PropertyGroup>

  <ItemGroup Condition=" '$(AgoraReferenceExtensions)' == 'true' And ('$(AgoraDeviceProduct)' == 'Video' Or '$(AgoraDeviceProduct)' == 'Voice') ">
    <AgoraExtension Include="Ains" />
    <AgoraExtension Include="AudioBeauty" />
  </ItemGroup>

  <ItemGroup Condition=" '$(AgoraReferenceExtensions)' == 'true' And '$(AgoraDeviceProduct)' == 'Video' ">
    <AgoraExtension Include="VirtualBackground" />
    <AgoraExtension Include="ClearVision" />
    <AgoraExtension Include="FaceDetection" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="@(AgoraExtension->'Net.Agora.Extensions.%(Identity).Android')"
                      Version="$(AgoraExtensionAndroidVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PackageReference Include="@(AgoraExtension->'Net.Agora.Extensions.%(Identity).iOS')"
                      Version="$(AgoraExtensionIosVersion)" />
  </ItemGroup>

  <!--
    The macOS extension packages. Without these the ExtensionsAreAvailable check fails on the macos
    leg exactly as it would in a consumer's app — which is how this group came to exist: the leg was
    added, the check refused SetLowLightEnhance with code -2, and the twelve Net.Agora.Extensions.*.Mac
    packages turned out to have had no runtime coverage anywhere.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <PackageReference Include="@(AgoraExtension->'Net.Agora.Extensions.%(Identity).Mac')"
                      Version="$(AgoraExtensionMacVersion)" />
  </ItemGroup>

  <!--
    Fastboard on iOS under .NET 8 only. Fastboard's native bridge (libAgoraFastboardBridge.a) is a
    Swift static library, so its objects force-load the Swift back-deployment compatibility shims:

        Undefined symbols for architecture arm64:
          "__swift_FORCE_LOAD_$_swiftCompatibility56"           (in AgoraFastboardBridge.o)
          "__swift_FORCE_LOAD_$_swiftCompatibilityConcurrency"  (in AgoraFastboardBridge.o)
        ld: symbol(s) not found for architecture arm64

    The archive carries the autolink hints for these (LC_LINKER_OPTION: -lswiftCompatibility56 …);
    they resolve as soon as the Swift toolchain's library directory is on the search path. The .NET
    9 and .NET 10 iOS SDKs add it; the .NET 8 one only does so for macOS (see the hard-coded
    "-L/usr/lib/swift" for _PlatformName == 'macOS' in Xamarin.Shared.Sdk.targets), which is why
    this breaks on the net8 leg alone and no other product — Fastboard is the only one with a Swift
    bridge. Mirror that macOS line for iOS: point the linker at the selected Xcode's Swift dir.

    $(_SdkDevPath) is the developer dir of the Xcode the build resolved (select-xcode.sh on CI), so
    this stays correct across image and patch-release rolls without a hard-coded /Applications path.
    Injected via _CustomLinkFlags (the same item the macOS line feeds) in a target before the native
    link, where $(_SdkDevPath) is populated. The internal target/property names are safe to depend
    on here: this is scoped to net8, whose iOS SDK is frozen, and net9/net10 never enter the target.
  -->
  <Target Name="_AgoraLinkFastboardSwiftCompatShims"
          BeforeTargets="_LinkNativeExecutable"
          Condition=" '$(AgoraDeviceProduct)' == 'Fastboard' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And $(TargetFramework.StartsWith('net8')) ">
    <PropertyGroup>
      <!-- The compat libs live under a per-platform subdir; pick it from the runtime identifier. -->
      <_AgoraSwiftPlatformDir>iphoneos</_AgoraSwiftPlatformDir>
      <_AgoraSwiftPlatformDir Condition="$(RuntimeIdentifier.Contains('simulator'))">iphonesimulator</_AgoraSwiftPlatformDir>
    </PropertyGroup>
    <ItemGroup>
      <_CustomLinkFlags Include="-L$(_SdkDevPath)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(_AgoraSwiftPlatformDir)" />
    </ItemGroup>
  </Target>

</Project>
